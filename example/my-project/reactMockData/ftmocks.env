PROJECT_NAME=My Project (React)
MOCK_DIR=./
PORT=5000
PROJECT_TYPE=react
PLAYWRIGHT_DIR=../playwright/
# This example is Create React App — bare `jest` can't transform JSX, so run
# tests via react-scripts (which provides the CRA babel/jest config).
REACT_TEST_COMMAND=npx react-scripts test --watchAll=false
REACT_TESTS_DIR=../src/tests
# Import path of the root App component, relative to the tests dir (REACT_TESTS_DIR).
# Used in generated code as `import App from '<REACT_APP_FROM_TESTS_DIR>'`.
REACT_APP_FROM_TESTS_DIR=../App
