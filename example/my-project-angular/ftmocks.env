PROJECT_NAME=My Project (Angular)
MOCK_DIR=./testMockData
PORT=5000
PREFERRED_SERVER_PORTS=[4051]
PROJECT_TYPE=angular
# Directory (relative to MOCK_DIR) where generated *.spec.ts files are saved.
ANGULAR_TESTS_DIR=../src/app/tests
# Command to run a single Angular test (jest-preset-angular). Default: npx jest
ANGULAR_TEST_COMMAND=npx jest
